FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY scripts/generate-schema-types.mjs ./scripts/generate-schema-types.mjs
COPY schemas ./schemas
COPY src ./src
RUN npm run check:generated && npm run build && npm prune --omit=dev --ignore-scripts
FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY schemas ./schemas
COPY migrations ./migrations
COPY prompts/slots/S1-immutable-v2.md ./prompts/slots/S1-immutable-v2.md
RUN mkdir /data && chown node:node /data
USER node
ENV GF_LIFE_DB=/data/life.db
VOLUME /data
CMD ["node","dist/gf/lifeCli.js"]
