{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gf.local/schemas/scene-settlement.schema.json",
  "title": "Idempotent scene settlement proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "scene_id",
    "batch_id",
    "base_state_revision",
    "processed_message_ids",
    "scene_summary",
    "claims",
    "patch_ops",
    "debts_add",
    "valence",
    "intensity",
    "involves"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation_id": { "$ref": "common.schema.json#/$defs/id" },
    "scene_id": { "$ref": "common.schema.json#/$defs/id" },
    "batch_id": { "$ref": "common.schema.json#/$defs/id" },
    "base_state_revision": { "type": "integer", "minimum": 0 },
    "processed_message_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "scene_summary": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "claim.schema.json" }
    },
    "patch_ops": {
      "type": "array",
      "maxItems": 48,
      "items": { "$ref": "patch-op.schema.json" }
    },
    "debts_add": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "debt.schema.json" }
    },
    "valence": { "type": "number", "minimum": -1, "maximum": 1 },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "involves": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
