{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gf.local/schemas/surface-message.schema.json",
  "title": "Authorized communication surface output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "speech_id", "operation_id", "channel",
    "recipient_principal_id", "privacy_scope", "capability_revision",
    "authorization_decision_id", "source_refs", "bubbles"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "speech_id": { "$ref": "common.schema.json#/$defs/id" },
    "operation_id": { "$ref": "common.schema.json#/$defs/id" },
    "channel": { "const": "private_im" },
    "recipient_principal_id": { "$ref": "common.schema.json#/$defs/id" },
    "privacy_scope": { "const": "private_im" },
    "capability_revision": { "type": "integer", "minimum": 0 },
    "authorization_decision_id": { "$ref": "common.schema.json#/$defs/id" },
    "source_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
    },
    "bubbles": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    }
  }
}
